# backend/.env.example
#
# backend/scripts/scrape_availability.py がスタジオミッションの空き状況を
# 取得する際に使用するログイン情報。resv.studio-mission.com は会員登録済み
# ユーザーでないと空室状況を閲覧できないため、既存の会員アカウント情報を
# ここに設定する。
#
# 使い方: このファイルをコピーして backend/.env を作成し、実際の値を入力すること。
# backend/.env は .gitignore 対象のためコミットされない。

MISSION_LOGIN_EMAIL=
MISSION_LOGIN_PASSWORD=
