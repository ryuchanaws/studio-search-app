.vscode/
node_modules/
# SAM build output（sam build のたびに再生成される）
.aws-sam/
infrastructure/.aws-sam/
# Python 仮想環境（環境依存のバイナリを含むため）
.venv/
backend/.venv/
# フロントエンドの build 成果物
frontend/dist/
# Python バイトコードキャッシュ
__pycache__/
**/__pycache__/
.pytest_cache/
# Playwright の一時出力
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
# 環境変数（実際の値はGitHub Secrets/ローカル.envで管理）
frontend/.env
.env
# backfill_studio_details.py 実行時の一時ログ
backend/scripts/*.log
backend/tmp_debug/
